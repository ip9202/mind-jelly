# Supabase - 개발 환경 (next dev)
NEXT_PUBLIC_SUPABASE_URL=your-dev-supabase-url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-dev-supabase-anon-key

# Supabase - 프로덕션 환경 (.env.production에 실제 값 입력)
# NEXT_PUBLIC_SUPABASE_URL=your-prod-supabase-url
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-prod-supabase-anon-key

# Zhipu AI (환경 무관 - .env.local에 입력)
# NEXT_PUBLIC_OPENAI_API_KEY=your-openai-api-key
# NEXT_PUBLIC_OPENAI_BASE_URL=https://open.bigmodel.cn/api/paas/v4

# 앱인토스 배포 API 키 (.env.local에 입력)
# AIT_API_KEY=your-ait-api-key
